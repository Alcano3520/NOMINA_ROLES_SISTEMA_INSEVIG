# Proxy inverso para INSEVIG — producción en el NAS (192.168.2.181).
# Copiar a C:\insevig\caddy\Caddyfile. Servicio Windows: insevig-caddy (NSSM).
#
# La app corre con:
#   reflex run --env prod --single-port --frontend-port 3000
# Por eso TODO (frontend + API + WebSocket /_event + uploads) va por :3000;
# Caddy solo termina HTTPS y hace reverse_proxy. No hay split a :8000.
#
# HTTPS automático: con los puertos 80 y 443 reenviados desde el router hacia
# este servidor, Caddy obtiene y renueva el certificado de Let's Encrypt solo.
# El dominio lo da DuckDNS (actualizar la IP pública en duckdns.org).
#
# LAN sin dominio público: reemplazar el nombre por `insevig-rrhh.local` y
# añadir `tls internal` dentro del bloque (aviso de cert salvo que se
# distribuya la CA raíz de Caddy por GPO).

insevig-rrhh.duckdns.org {
	encode zstd gzip

	reverse_proxy 127.0.0.1:3000

	log {
		output file C:/insevig/logs/caddy-access.log {
			roll_size 20MiB
			roll_keep 8
		}
	}
}
