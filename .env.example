# Copiar a .env y completar. NUNCA commitear .env (está en .gitignore).
# En el Windows Server: C:\insevig\app\.env con ACL restringida a la cuenta de servicio.

# ── SQL Server (fuente de verdad) ───────────────────────────────────────────────
SQLSERVER_HOST=192.168.2.115
SQLSERVER_DB=insevig
# Logins dedicados con permisos mínimos (reemplazar el 'sa' compartido):
SQLSERVER_USER_RO=insevig_ro
SQLSERVER_PWD_RO=
SQLSERVER_USER_RW=insevig_rw
SQLSERVER_PWD_RW=
SQLSERVER_FILTER=CODEMP='10' AND CODSUC='10'
SQLSERVER_ENCRYPT=no
SQLSERVER_TRUST_CERT=true
SQLSERVER_TIMEOUT=10

# ── Supabase (espejo solo lectura) ─────────────────────────────────────────────
# ROTAR la key filtrada en git. Idealmente una key restringida + RLS, no service_role.
SUPABASE_URL=
SUPABASE_KEY=

# ── Postgres de la app (auth, auditoría, jobs, historial de préstamos migrado) ──
# dev: sqlite:///./var/insevig_app.db   prod: postgresql+psycopg://user:pass@host/insevig_app
APP_DB_URL=sqlite:///./var/insevig_app.db

# ── Email (reemplazo de Outlook COM) ──────────────────────────────────────────
EMAIL_BACKEND=console        # console | smtp | graph
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SENDER=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# ── IA (narrativa de préstamos) ──────────────────────────────────────────────
IA_PROVIDER=none             # none | groq | openrouter | ollama
IA_API_KEY=
IA_BASE_URL=http://localhost:11434
IA_MODEL=llama3.1

# ── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=cambiar-esto-por-un-valor-aleatorio-largo
STORAGE_DIR=./var/storage
FEATURE_FLAGS=
